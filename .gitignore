# Dependencies and generated build output
node_modules/
.next/
out/
dist/
coverage/
*.tsbuildinfo

# Local environment files and secrets
.env
.env.local
.env.*.local
.env.wordpress

# Runtime logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database exports and local backups
backups/*
!backups/.gitignore
*.sql
*.sql.gz
*.dump
*.bak

# Archives should be published as release artifacts, not Git blobs
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# Private TLS and signing material
*.key
*.pem
*.p12
*.pfx

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
