# Chỉ dùng cho môi trường development. Hãy copy file này thành .env.wordpress.
WORDPRESS_PORT=8080
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress_demo_change_me
WORDPRESS_DB_ROOT_PASSWORD=root_demo_change_me
WORDPRESS_ADMIN_USER=fastbyte_demo_admin
WORDPRESS_ADMIN_PASSWORD=fastbyte_demo_admin_change_me
WORDPRESS_ADMIN_EMAIL=dev@example.test
WORDPRESS_TITLE=Fast Byte Headless CMS Local
FASTBYTE_HEADLESS_WEBHOOK_URL=http://host.docker.internal:3000/api/revalidate/wordpress
FASTBYTE_HEADLESS_WEBHOOK_SECRET=thay-bang-secret-giong-wordpress-revalidate-secret
