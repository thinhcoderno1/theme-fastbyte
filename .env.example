# Copy this file to .env. Never commit the populated .env file.

# Public DNS names. Point both A/AAAA records at this Docker host.
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com

# MySQL initialization credentials. Use long, unique random values.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=replace-with-a-long-random-database-password

# WordPress database settings must match the MySQL values above.
WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-database-password
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=false

# Next.js public/runtime configuration. Do not put secrets in NEXT_PUBLIC_*.
NODE_ENV=production
NEXT_PUBLIC_API_URL=https://admin.example.com/wp-json/wp/v2
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_ASSET_BASE_URL=https://admin.example.com
NEXT_PUBLIC_ALLOW_INDEXING=true

# Server-side WordPress endpoints used by this Next.js application.
WORDPRESS_API_URL=https://admin.example.com/wp-json/wp/v2
WORDPRESS_SITE_URL=https://admin.example.com

# Generate independently, for example: openssl rand -hex 32
WORDPRESS_REVALIDATE_SECRET=replace-with-a-random-revalidation-secret
WORDPRESS_PREVIEW_SECRET=replace-with-a-different-random-preview-secret
