# Copy this file to .env. Never commit the populated .env file.

# Public DNS name. Point its A/AAAA record at this Docker host.
APP_DOMAIN=app.example.com

# Next.js public/runtime configuration. Do not put secrets in NEXT_PUBLIC_*.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.example.com
NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.example.com
NEXT_PUBLIC_ALLOW_INDEXING=true

# Server-side WordPress endpoints used by this Next.js application.
WORDPRESS_API_URL=https://cms.example.com/wp-json/wp/v2
WORDPRESS_SITE_URL=https://cms.example.com

# Generate independently, for example: openssl rand -hex 32
WORDPRESS_REVALIDATE_SECRET=replace-with-a-random-revalidation-secret
